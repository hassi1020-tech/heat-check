rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsPersonalWorkspace(workspaceId) {
      return signedIn() && workspaceId == request.auth.uid;
    }

    function sharedWorkspaceMember(workspaceId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/heatCheckWorkspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    match /heatCheckWorkspaces/{workspaceId} {
      allow read, write: if ownsPersonalWorkspace(workspaceId) || sharedWorkspaceMember(workspaceId);

      match /{document=**} {
        allow read, write: if ownsPersonalWorkspace(workspaceId) || sharedWorkspaceMember(workspaceId);
      }
    }
  }
}